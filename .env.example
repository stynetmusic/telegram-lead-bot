# Скопируйте этот файл в .env и подставьте свои значения.
# Настоящий токен в проект не записывайте и никому не отправляйте.

# Токен от @BotFather.
BOT_TOKEN=put-your-telegram-bot-token-here

# Числовые Telegram ID администраторов через запятую.
# Свой ID можно узнать командой /id после первого запуска бота.
ADMIN_IDS=123456789

# Необязательные параметры.
BUSINESS_NAME=Сервис заявок
# База и Excel по умолчанию создаются на внутреннем диске:
# ~/Library/Application Support/Stynet/TelegramLeadBot/
# Раскомментируйте строки ниже, только если нужен другой путь.
# DATABASE_PATH=/absolute/path/leads.db
# EXPORT_DIR=/absolute/path/exports
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Если переменная пустая, журнал пишется только в консоль.
LOG_FILE=
